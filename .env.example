# Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://contact:sifre@db:5432/contact

# SMTP (bildirim mailleri)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
MAIL_FROM="Contact Form <noreply@example.com>"
MAIL_TO=ben@example.com

# Form kabul edilen siteler ve CORS origin'leri (virgülle ayrılmış)
ALLOWED_SITES=portfolio,blog
ALLOWED_ORIGINS=https://ornek.com,https://www.ornek.com

# Pageview analytics (POST /api/pageview, GET /api/pageview/stats)
# Pageview gönderebilecek host'lar — şema YOK, sadece host (Origin/Referer host'u bununla eşleşir).
# Verilmezse: barisonurme.com,www.barisonurme.com,localhost,127.0.0.1
PAGEVIEW_ALLOWED_ORIGINS=barisonurme.com,www.barisonurme.com,localhost,127.0.0.1
# Pageview için kabul edilen site id'leri. Boşsa ALLOWED_SITES kullanılır.
PAGEVIEW_ALLOWED_SITES=
# Günlük ziyaretçi-hash salt'ı buradan türetilir. En az 16 karakter: openssl rand -hex 32
# Değiştirmek = tüm visitorHash'leri geçersiz kılar (unique sayımı sıfırlanır).
SERVER_SECRET=

# Admin
# Giriş şifresiz: panel "kod gönder" der, 6 haneli kod MAIL_TO adresine gelir.
# Session JWT imzası, en az 32 karakter: openssl rand -hex 32
JWT_SECRET=
# Önümüzdeki güvenilir reverse-proxy sayısı (Caddy = 1). Client IP,
# X-Forwarded-For'un sağdan N. değeri olarak okunur. 0 = proxy yok (lokal).
TRUSTED_PROXY_HOPS=1
